{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jonathan-vella/apex/schemas/governance-constraints.schema.json",
  "title": "APEX Governance Constraints",
  "description": "Shape of agent-output/{project}/04-governance-constraints.json produced by 04g-Governance. Generated by discover.py: never hand-edit it, because a re-run overwrites additions and any edit breaks the recorded signature; put additions in owner-controlled artifacts. Used by 06b/06t codegen agents and enforced in CI by scripts/validate-artifacts.mjs (Step 5b). The optional discovery_metadata envelope is the L0 attestation in the four-layer governance stack (L0 envelope → L1 plan matrix → L2 code attestation → L3 live precheck). discovery_metadata is warn-only for 30 days after rollout, then required.",
  "type": "object",
  "required": ["schema_version", "subscription_id", "discovered_at", "findings"],
  "additionalProperties": true,
  "dependentRequired": {
    "rule_evidence": ["discovery_metadata", "project", "discovery_options", "discovery_summary"]
  },
  "allOf": [
    {
      "if": { "required": ["rule_evidence"] },
      "then": { "properties": { "discovery_metadata": { "required": ["rule_evidence_sha256"] } } }
    }
  ],
  "properties": {
    "rule_evidence": {
      "description": "Optional full raw objects and replayable effective rules, retained only in owner-only private snapshots outside Git. The entire snapshot remains bound by the existing private file SHA-256.",
      "type": "object",
      "required": [
        "schema_version",
        "project",
        "subscription_id",
        "discovered_at",
        "assignments",
        "definitions",
        "initiatives",
        "exemptions",
        "effective_records",
        "coverage"
      ],
      "additionalProperties": false,
      "properties": {
        "schema_version": { "const": "policy-rule-evidence-v1" },
        "project": { "type": "string", "minLength": 1 },
        "subscription_id": { "type": "string", "minLength": 1 },
        "discovered_at": { "type": "string", "format": "date-time" },
        "assignments": { "type": "array", "items": { "type": "object", "required": ["id", "properties"] } },
        "definitions": { "type": "array", "items": { "type": "object", "required": ["id", "properties"] } },
        "initiatives": { "type": "array", "items": { "type": "object", "required": ["id", "properties"] } },
        "exemptions": { "type": "array", "items": { "type": "object", "required": ["id", "properties"] } },
        "effective_records": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "assignment_id",
              "policy_definition_id",
              "policy_definition_reference_id",
              "supplied_parameters",
              "effective_parameters",
              "policy_rule",
              "effect"
            ],
            "additionalProperties": false,
            "properties": {
              "assignment_id": { "type": "string", "minLength": 1 },
              "policy_definition_id": { "type": "string", "minLength": 1 },
              "policy_definition_reference_id": { "type": ["string", "null"] },
              "supplied_parameters": { "type": "object" },
              "effective_parameters": { "type": "object" },
              "policy_rule": {
                "type": ["object", "null"],
                "properties": { "if": { "type": "object" }, "then": { "type": "object" } }
              },
              "effect": { "type": ["string", "null"] }
            }
          }
        },
        "coverage": {
          "type": "object",
          "required": ["assignment_count", "effective_record_count", "effects"],
          "additionalProperties": false,
          "properties": {
            "assignment_count": { "type": "integer", "minimum": 0 },
            "effective_record_count": { "type": "integer", "minimum": 0 },
            "effects": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } }
          }
        }
      }
    },
    "schema_version": {
      "type": "string",
      "const": "governance-constraints-v1"
    },
    "subscription_id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F-]{36}$|^unknown$"
    },
    "discovered_at": { "type": "string", "format": "date-time" },
    "source": {
      "type": "string",
      "enum": ["azure-policy-rest-api", "az-cli", "static", "partial", "github-actions-baseline", "alz-corp-default"]
    },
    "discovery_metadata": {
      "description": "L0 attestation envelope. Mandatory after 30-day rollout window; warn-only before then. Every downstream consumer (05-IaC Planner, 06b/06t CodeGen, 07b/07t Deploy) reads this first and STOPS on staleness, signature drift, or non-COMPLETE status.",
      "type": "object",
      "required": [
        "discovery_status",
        "discovered_at",
        "scope",
        "api_versions",
        "page_counts",
        "completeness_signature",
        "ttl_days"
      ],
      "additionalProperties": true,
      "properties": {
        "discovery_status": {
          "type": "string",
          "enum": ["COMPLETE", "PARTIAL", "FAILED"]
        },
        "discovered_at": { "type": "string", "format": "date-time" },
        "scope": {
          "type": "object",
          "required": ["subscription_id", "management_groups"],
          "additionalProperties": true,
          "properties": {
            "subscription_id": {
              "type": "string",
              "pattern": "^[0-9a-fA-F-]{36}$|^unknown$"
            },
            "management_groups": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "api_versions": {
          "type": "object",
          "required": ["policyAssignments", "policyDefinitions"],
          "additionalProperties": { "type": "string" },
          "properties": {
            "policyAssignments": { "type": "string" },
            "policyDefinitions": { "type": "string" },
            "policyExemptions": { "type": "string" }
          }
        },
        "page_counts": {
          "type": "object",
          "required": ["policyAssignments", "policyDefinitions"],
          "additionalProperties": { "type": "integer", "minimum": 0 },
          "properties": {
            "policyAssignments": { "type": "integer", "minimum": 0 },
            "policyDefinitions": { "type": "integer", "minimum": 0 },
            "policyExemptions": { "type": "integer", "minimum": 0 }
          }
        },
        "completeness_signature": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "rule_evidence_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "ttl_days": {
          "type": "integer",
          "minimum": 1,
          "maximum": 90
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["policy_id", "display_name", "effect"],
        "additionalProperties": true,
        "properties": {
          "policy_id": { "type": "string", "minLength": 1 },
          "display_name": { "type": "string", "minLength": 1 },
          "effect": {
            "type": "string",
            "enum": ["deny", "audit", "auditIfNotExists", "append", "modify", "deployIfNotExists", "disabled"]
          },
          "scope": { "type": "string" },
          "azurePropertyPath": { "type": "string" },
          "bicepPropertyPath": { "type": "string" },
          "terraformPropertyPath": { "type": "string" },
          "required_value": {},
          "resource_types": { "type": "array", "items": { "type": "string" } },
          "override": {
            "type": ["object", "null"],
            "required": ["requested_at", "reason", "issue_link", "expiry"],
            "additionalProperties": false,
            "properties": {
              "requested_at": { "type": "string", "format": "date-time" },
              "requested_by": { "type": "string" },
              "reason": { "type": "string", "minLength": 8 },
              "issue_link": { "type": "string", "format": "uri" },
              "expiry": { "type": "string", "format": "date" }
            }
          }
        }
      }
    },
    "tags_required": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string" },
          "allowed_values": { "type": "array", "items": { "type": "string" } },
          "default": { "type": "string" }
        }
      }
    },
    "allowed_locations": {
      "type": "array",
      "items": { "type": "string" }
    },
    "policies": {
      "description": "Alias of findings — same array reference, emitted by discover.py for downstream consumers.",
      "type": "array",
      "items": { "$ref": "#/properties/findings/items" }
    }
  }
}
