{
  "id": "python",
  "version": "1.0.0",
  "name": "Python",
  "description": "Installs pinned uv-managed Python and an isolated writable development environment without DNF 4 flags.",
  "containerEnv": {
    "PATH": "/usr/local/python/current/bin:${PATH}"
  },
  "options": {
    "version": {
      "type": "string",
      "default": "3.15.0",
      "description": "Exact stable Python interpreter release."
    },
    "pipVersion": {
      "type": "string",
      "default": "26.2.1",
      "description": "Exact stable pip release."
    }
  }
}
