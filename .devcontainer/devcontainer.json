{
  "name": "APEX",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },

  "features": {
    "ghcr.io/devcontainers/features/azure-cli:1": {
      "installBicep": true,
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/powershell:2": {
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.14",
      "installTools": false
    },
    "ghcr.io/devcontainers/features/node:2": {
      "version": "lts",
      "pnpmVersion": "none"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {
      "version": "latest"
    },
    "./features/terraform": {},
    "ghcr.io/azure/azure-dev/azd:latest": {}
  },

  // OS tools, uv and gitleaks are installed in the image before features run.
  // Locked Azure CLI 1.3.0 supports resolute; fail if its installation is unusable.
  "onCreateCommand": "az version --output none",
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "postStartCommand": "bash .devcontainer/post-start.sh",

  // Environment variables for Python optimization
  "containerEnv": {
    "PYTHONDONTWRITEBYTECODE": "1",
    "PYTHONUNBUFFERED": "1",
    "NPM_CONFIG_REGISTRY": "https://packagefeedproxy.microsoft.io/npm/",
    "UV_CACHE_DIR": "/home/vscode/.cache/uv",
    "PIP_INDEX_URL": "https://packagefeedproxy.microsoft.io/pypi/simple/",
    "UV_INDEX_URL": "https://packagefeedproxy.microsoft.io/pypi/simple/",
    "TF_PLUGIN_CACHE_DIR": "/home/vscode/.terraform.d/plugin-cache"
  },

  "remoteEnv": {
    "PATH": "/home/vscode/.local/bin:${containerEnv:PATH}",
    "AZURE_DEFAULTS_LOCATION": "swedencentral",
    // Forward GH_TOKEN from the host process environment inherited by VS Code.
    // terminal.integrated.env.* configures terminals, not this localEnv substitution.
    // If unset, gh can use credentials in its mounted config volume.
    "GH_TOKEN": "${localEnv:GH_TOKEN}"
  },

  "customizations": {
    "vscode": {
      // Keep editor extensions limited to core APEX language and GitHub UX.
      // Azure MCP runs from .vscode/mcp.json rather than an extension pack.
      "extensions": [
        "GitHub.copilot-chat",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-azuretools.vscode-azureresourcegroups",
        "ms-azuretools.vscode-bicep",
        "ms-vscode.powershell",
        "github.vscode-github-actions",
        "github.vscode-pull-request-github",
        "esbenp.prettier-vscode",
        "redhat.vscode-yaml",
        "HashiCorp.terraform"
      ],
      "settings": {
        "chat.useAgentsMdFile": true,
        "chat.useNestedAgentsMdFiles": true,
        "chat.useClaudeMdFile": false,
        "chat.customAgentInSubagent.enabled": true,
        "chat.agentFilesLocations": {
          ".github/agents": true,
          ".github/agents/_subagents": true,
          "~/.copilot/agents": false,
          "~/.claude/agents": false
        },
        "chat.agentSkillsLocations": {
          ".github/skills": true,
          "~/.copilot/skills": false,
          "~/.claude/skills": false
        },
        "chat.instructionsFilesLocations": {
          ".github/instructions": true,
          "~/.copilot/instructions": false,
          "~/.claude/rules": false
        },
        "chat.hookFilesLocations": {
          ".github/hooks/tool-guardian": true,
          ".github/hooks/subagent-validation": true
        },
        "chat.useCustomAgentHooks": true,
        "chat.useAgentSkills": true,
        "github.copilot.chat.agentDebugLog.fileLogging.enabled": true,
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.rulers": [120],
        "editor.wordWrap": "wordWrapColumn",
        "editor.wordWrapColumn": 120,
        "terminal.integrated.defaultProfile.linux": "bash",
        "files.eol": "\n",
        "editor.tabSize": 2,
        "[markdown]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode",
          "editor.rulers": [120],
          "editor.wordWrap": "wordWrapColumn",
          "editor.wordWrapColumn": 120
        },
        "[bicep]": {
          "editor.tabSize": 2
        },
        "[terraform]": {
          "editor.tabSize": 2,
          "editor.formatOnSave": true,
          "editor.defaultFormatter": "hashicorp.terraform"
        },
        "[powershell]": {
          "editor.tabSize": 4
        },
        "[python]": {
          "editor.tabSize": 4
        },
        "python.defaultInterpreterPath": "/usr/local/python/current/bin/python3",
        "python.analysis.typeCheckingMode": "basic"
      }
    }
  },

  // Mounts for credential/cache persistence across rebuilds
  // - Azure CLI: Host's ~/.azure (Linux/macOS) or %USERPROFILE%\.azure (Windows)
  // - GitHub CLI: Docker volume (Windows uses keyring, can't be mounted; Linux/macOS use files)
  // - UV cache: Docker volume for Python package cache
  // - Terraform providers: Docker volume for downloaded provider packages
  "mounts": [
    {
      "source": "${localEnv:USERPROFILE}${localEnv:HOME}/.azure",
      "target": "/home/vscode/.azure",
      "type": "bind"
    },
    {
      "source": "devcontainer-gh-config-${devcontainerId}",
      "target": "/home/vscode/.config/gh",
      "type": "volume"
    },
    {
      "source": "devcontainer-uv-cache-${devcontainerId}",
      "target": "/home/vscode/.cache/uv",
      "type": "volume"
    },
    {
      "source": "devcontainer-tf-cache-${devcontainerId}",
      "target": "/home/vscode/.terraform.d/plugin-cache",
      "type": "volume"
    }
  ],

  "remoteUser": "vscode"
}
